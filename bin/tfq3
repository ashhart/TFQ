#!/usr/bin/env bash
set -euo pipefail

TFQ3_VERSION="3.0.0"

usage() {
    cat <<'EOF'
tfq3 — TensorFold Native Quantization (TFQ3 3/4/5-bit & TFQ4 2-bit E8P, Metal & CUDA)

Usage:
  tfq3 <MODEL> [options]              Convert a model directory or HF repo id to TFQ3/TFQ4
  tfq3 convert <MODEL> [options]      Same as above
  tfq3 inspect [-v] <TFQ_DIR>         Validate and inspect a TFQ3 or TFQ4 checkpoint
  tfq3 doctor                         Show detected GPU backend, tools, and install paths
  tfq3 --version | --help

Options:
  -o, --out DIR              Output directory (default: <model>-TFQ3, or <model>-TFQ4 for --bits 2)
  --family NAME              auto | generic | qwen27 | flashnext | glm | inkling2 | ernie (default: auto)
  --profile PROFILE          Bit profile: 4b | 3.5b | 3b | 5b (default: 4b; ERNIE: 3b | 4b | 5b)
  --bits N                   Uniform bit width for generic converter: 2 (TFQ4-E8P) | 3 | 4 | 5
  --target-gib GB            Fit total checkpoint into GB via data-free sensitivity allocation
  --fit auto|GB              Auto-size to local GPU memory budget (or explicit GB)
  --residual MODE            Qwen3.8-27B residual precision: auto | bf16 | q8 (default: auto)
  --head-bits N              lm_head bits: TFQ3 0 | 4 | 5 (default: 4); TFQ4 0 | 2 (default: 0 keeps lm_head in residual)
  --ple-bits N               Qwen3.8-Flash-Next PLE bits: 3 | 4 (default: 3)
  --quantize-vision          Also quantize vision tower linears (generic converter)
  --quantize-drafter         Quantize standalone DFlash2 / DSpine drafter checkpoint
  --quantize-embed           Also quantize embed_tokens table (generic converter)
  --max-shard-gib GB         Max TFQ4 shard size in GiB (default: 3.4)
  --trace FILE               Optional trace-guided HeatAlloc routing counts (uses calibration counts)
  --glm-mode MODE            GLM deep-layer MoE bit mode: heat43 (3.33 bpw) | uniform4 (4.00 bpw)
  --inkling2-mode MODE       Inkling-2 MoE bit mode: uniform3 | heat43 | heat443 | heat543 | uniform4
  --keep-nonmoe-bf16         GLM: skip nonmoe.tffpw quantization so attention/shared/head stay full-precision
  --nonmoe-model DIR         Optional 8-bit source for GLM nonmoe.tffpw
  --skip-existing            Resume MoE conversion, skipping finished shards
  --no-pull, --no-download   Fail instead of pulling an uncached Hugging Face repo id
  --dry-run                  Print the resolved conversion plan without running it

Examples:
  tfq3 Qwen/Qwen3.8-27B
  tfq3 meta-llama/Llama-3.1-8B-Instruct --target-gib 4.5
  tfq3 Qwen/Qwen2.5-1.5B --bits 2 --quantize-embed
  tfq3 /path/to/Qwen3.8-27B --profile 3.5b
  tfq3 inspect -v ./Qwen3.8-27B-TFQ3
EOF
}

die() {
    echo "tfq3: error: $*" >&2
    exit 1
}

resolve_self() {
    python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"
}

find_lib_dir() {
    if [ -n "${TFQ3_LIB_DIR:-}" ] && [ -d "${TFQ3_LIB_DIR}" ]; then
        echo "${TFQ3_LIB_DIR}"
        return
    fi
    local self_real bin_dir parent
    self_real="$(resolve_self "$0")"
    bin_dir="$(dirname "$self_real")"
    parent="$(dirname "$bin_dir")"
    if [ -d "$parent/lib/tfq3" ]; then
        echo "$parent/lib/tfq3"
    elif [ -d "$parent/build" ]; then
        echo "$parent/build"
    else
        echo "$bin_dir"
    fi
}

find_flashnext_packager() {
    local lib_dir="$1"
    local self_real parent
    self_real="$(resolve_self "$0")"
    parent="$(dirname "$(dirname "$self_real")")"
    if [ -f "$lib_dir/flashnext_package.py" ]; then
        echo "$lib_dir/flashnext_package.py"
    elif [ -f "$parent/src/converters/flashnext/package.py" ]; then
        echo "$parent/src/converters/flashnext/package.py"
    else
        die "could not locate flashnext packager script (re-run make install)"
    fi
}

backend_suffix() {
    if [ "$(uname -s)" = "Darwin" ]; then
        echo ""
    else
        echo "-cuda"
    fi
}

require_tool() {
    local lib_dir="$1"
    local name="$2"
    local p="$lib_dir/$name"
    if [ ! -x "$p" ]; then
        die "missing binary $p (build with 'make' or re-run install.sh)"
    fi
    echo "$p"
}

is_repo_id() {
    python3 - "$1" <<'PY'
import re, sys
s = sys.argv[1]
repo = s.split("@", 1)[0]
ok = bool(re.fullmatch(r"[A-Za-z0-9._-]{1,96}/[A-Za-z0-9._-]{1,96}", repo))
sys.exit(0 if ok else 1)
PY
}

find_hf_cached_snapshot() {
    python3 - "$1" <<'PY'
import os, sys
spec = sys.argv[1]
repo = spec.split("@", 1)[0]
if "/" not in repo:
    sys.exit(1)
org, name = repo.split("/", 1)
hub = os.environ.get("HF_HUB_CACHE")
if not hub:
    hf_home = os.environ.get("HF_HOME")
    if hf_home:
        hub = os.path.join(hf_home, "hub")
    else:
        hub = os.path.join(os.path.expanduser("~"), ".cache", "huggingface", "hub")
root = os.path.join(hub, f"models--{org}--{name}")
ref_path = os.path.join(root, "refs", "main")
if os.path.isfile(ref_path):
    rev = open(ref_path, "r", encoding="utf-8").read().strip()
    if len(rev) == 40 and all(c in "0123456789abcdefABCDEF" for c in rev):
        snap = os.path.join(root, "snapshots", rev)
        if os.path.isdir(snap) and os.path.isfile(os.path.join(snap, "config.json")):
            print(snap)
            sys.exit(0)
snaps = os.path.join(root, "snapshots")
if os.path.isdir(snaps):
    candidates = []
    for entry in os.listdir(snaps):
        p = os.path.join(snaps, entry)
        if os.path.isdir(p) and os.path.isfile(os.path.join(p, "config.json")):
            candidates.append((os.path.getmtime(p), p))
    if candidates:
        candidates.sort(reverse=True)
        print(candidates[0][1])
        sys.exit(0)
sys.exit(1)
PY
}

pull_repo_model() {
    local spec="$1"
    local repo="${spec%%@*}"
    local rev=""
    if [[ "$spec" == *@* ]]; then
        rev="${spec#*@}"
    fi
    if command -v tensorfold >/dev/null 2>&1; then
        echo "==> Pulling ${spec} with tensorfold pull..."
        tensorfold pull "$spec"
        return 0
    fi
    if command -v hf >/dev/null 2>&1; then
        echo "==> Pulling ${spec} with hf download..."
        if [ -n "$rev" ]; then
            hf download "$repo" --revision "$rev"
        else
            hf download "$repo"
        fi
        return 0
    fi
    if command -v huggingface-cli >/dev/null 2>&1; then
        echo "==> Pulling ${spec} with huggingface-cli download..."
        if [ -n "$rev" ]; then
            huggingface-cli download "$repo" --revision "$rev"
        else
            huggingface-cli download "$repo"
        fi
        return 0
    fi
    die "${spec} is not in the local Hugging Face cache and neither 'tensorfold', 'hf', nor 'huggingface-cli' is installed. Pull the model first or pass a local directory."
}

inspect_model_config() {
    python3 - "$1" <<'PY'
import json, os, sys
model_dir = sys.argv[1]
cfg_path = os.path.join(model_dir, "config.json")
if not os.path.isfile(cfg_path):
    sys.stderr.write(f"tfq3: error: missing config.json in {model_dir}\n")
    sys.exit(2)
cfg = json.load(open(cfg_path, "r", encoding="utf-8"))
mt = cfg.get("model_type") or ""
tc = cfg.get("text_config") if isinstance(cfg.get("text_config"), dict) else {}
if not mt:
    mt = tc.get("model_type") or ""
q = cfg.get("quantization") or cfg.get("quantization_config") or tc.get("quantization")
is_mlx_q8 = False
is_fp8 = False
if isinstance(q, dict):
    if q.get("bits") == 8 and q.get("group_size") in (32, 64, 128):
        is_mlx_q8 = True
    qm = str(q.get("quant_method") or "").lower()
    if "fp8" in qm:
        is_fp8 = True
if not is_fp8:
    # Hybrid FP8-MoE + MLX-Q8 non-MoE checkpoints (e.g. GLM-5.3-Flash-FP8E-MLX8)
    for fn in os.listdir(model_dir):
        if fn.startswith("e4m3-") and fn.endswith(".safetensors"):
            is_fp8 = True
            break
family = "unknown"
if mt in ("qwen3_5", "qwen3_5_text"):
    family = "qwen27"
elif mt == "qwen4_exp":
    family = "flashnext"
elif mt in ("glm5_next", "glm_moe_dsa"):
    family = "glm"
elif mt == "inkling2":
    family = "inkling2"
elif mt == "ernie5_5_moe":
    family = "ernie"
nl = tc.get("num_hidden_layers") or cfg.get("num_hidden_layers") or 0
mtp = cfg.get("num_nextn_predict_layers") or 0
if mt == "glm_moe_dsa":
    nl = int(nl) + int(mtp)
print(f"{family}|{mt}|{'q8' if is_mlx_q8 else 'bf16'}|{'fp8' if is_fp8 else 'other'}|{nl}")
PY
}

default_out_dir() {
    python3 - "$1" "$2" "$3" <<'PY'
import os, sys
raw, is_repo, tag = sys.argv[1], sys.argv[2] == "1", sys.argv[3]
if is_repo:
    repo = raw.split("@", 1)[0]
    base = repo.split("/", 1)[1]
    print(os.path.join(".", f"{base}-{tag}"))
else:
    p = os.path.normpath(os.path.expanduser(raw))
    parent = os.path.dirname(p)
    base = os.path.basename(p)
    out = os.path.join(parent, f"{base}-{tag}") if parent else f"{base}-{tag}"
    print(out)
PY
}

run_doctor() {
    local lib_dir suffix
    lib_dir="$(find_lib_dir)"
    suffix="$(backend_suffix)"
    echo "tfq3 ${TFQ3_VERSION}"
    echo "platform: $(uname -s) ($(uname -m))"
    if [ "$(uname -s)" = "Darwin" ]; then
        echo "backend:  Apple Silicon Metal"
    else
        echo "backend:  NVIDIA CUDA"
        if command -v nvidia-smi >/dev/null 2>&1; then
            echo "gpu:      $(nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader 2>/dev/null | head -n 1)"
        fi
    fi
    echo "lib_dir:  ${lib_dir}"
    local bins=("tfq3-generic-convert${suffix}" "tfq4-convert${suffix}" "tfq3-qwen27-convert${suffix}" "tfq3-qwen27-package" "tfq3-flashnext-convert${suffix}" "tfq3-glm-convert${suffix}" "tfq3-inkling2-convert${suffix}")
    [ "$(uname -s)" = "Darwin" ] || bins+=("tfq3-ernie-convert-cuda")  # CUDA only, no Metal build
    bins+=("tfq3-inspect")
    for b in "${bins[@]}"; do
        if [ -x "$lib_dir/$b" ]; then
            if [ "$(uname -s)" = "Darwin" ] && [[ "$b" == *-convert ]] && [ ! -f "$lib_dir/${b}.metallib" ]; then
                echo "  [warn]  $b (missing ${b}.metallib)"
            else
                echo "  [ok]    $b"
            fi
        else
            echo "  [miss]  $b"
        fi
    done
    if command -v tensorfold >/dev/null 2>&1; then
        echo "tensorfold: $(command -v tensorfold)"
    elif command -v tensorfold-native >/dev/null 2>&1; then
        echo "tensorfold: $(command -v tensorfold-native)"
    else
        echo "tensorfold: not found on PATH (optional; install from https://github.com/ashhart/TensorFold)"
    fi
}

run_cmd() {
    if [ "$DRY_RUN" -eq 1 ]; then
        printf '[dry-run]'
        for arg in "$@"; do printf ' %q' "$arg"; done
        printf '\n'
    else
        "$@"
    fi
}

run_convert() {
    local model_arg=""
    local out_dir=""
    local family="auto"
    local profile="4b"
    local bits_override=""
    local target_gib=""
    local fit_mode=""
    local residual="auto"
    local head_bits="4"
    local head_bits_set=0
    local ple_bits="3"
    local quantize_vision=0
    local quantize_drafter=0
    local quantize_embed=0
    local max_shard_gib=""
    local trace_file=""
    local glm_mode="heat43"
    local inkling2_mode=""
    local keep_nonmoe_bf16=0
    local nonmoe_model=""
    local skip_existing=0
    local no_pull=0
    DRY_RUN=0

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            -o|--out) [ $# -ge 2 ] || die "--out requires a directory"; out_dir="$2"; shift 2 ;;
            --family) [ $# -ge 2 ] || die "--family requires a value"; family="$2"; shift 2 ;;
            --profile) [ $# -ge 2 ] || die "--profile requires 4b|3.5b|3b|5b"; profile="$2"; shift 2 ;;
            --bits) [ $# -ge 2 ] || die "--bits requires 2|3|4|5"; bits_override="$2"; shift 2 ;;
            --target-gib) [ $# -ge 2 ] || die "--target-gib requires GB"; target_gib="$2"; shift 2 ;;
            --fit) [ $# -ge 2 ] || die "--fit requires auto or GB"; fit_mode="$2"; shift 2 ;;
            --residual) [ $# -ge 2 ] || die "--residual requires auto|bf16|q8"; residual="$2"; shift 2 ;;
            --head-bits) [ $# -ge 2 ] || die "--head-bits requires 0|2|4|5"; head_bits="$2"; head_bits_set=1; shift 2 ;;
            --ple-bits) [ $# -ge 2 ] || die "--ple-bits requires 3|4"; ple_bits="$2"; shift 2 ;;
            --quantize-vision) quantize_vision=1; shift ;;
            --quantize-drafter) quantize_drafter=1; shift ;;
            --quantize-embed) quantize_embed=1; shift ;;
            --max-shard-gib) [ $# -ge 2 ] || die "--max-shard-gib requires GB"; max_shard_gib="$2"; shift 2 ;;
            --trace) [ $# -ge 2 ] || die "--trace requires a file path"; trace_file="$2"; shift 2 ;;
            --glm-mode) [ $# -ge 2 ] || die "--glm-mode requires heat43|uniform4"; glm_mode="$2"; shift 2 ;;
            --inkling2-mode) [ $# -ge 2 ] || die "--inkling2-mode requires uniform3|heat43|heat443|heat543|uniform4"; inkling2_mode="$2"; shift 2 ;;
            --keep-nonmoe-bf16) keep_nonmoe_bf16=1; shift ;;
            --nonmoe-model) [ $# -ge 2 ] || die "--nonmoe-model requires a directory"; nonmoe_model="$2"; shift 2 ;;
            --skip-existing) skip_existing=1; shift ;;
            --no-pull|--no-download) no_pull=1; shift ;;
            --dry-run) DRY_RUN=1; shift ;;
            -*) die "unknown option: $1 (run 'tfq3 --help')" ;;
            *)
                if [ -z "$model_arg" ]; then
                    model_arg="$1"
                    shift
                else
                    die "unexpected argument: $1 (use --out DIR to set the output directory)"
                fi
                ;;
        esac
    done

    [ -n "$model_arg" ] || { usage >&2; exit 2; }
    case "$bits_override" in ""|2|3|4|5) ;; *) die "invalid --bits '${bits_override}' (expected 2, 3, 4, or 5)" ;; esac

    local expanded_model="${model_arg/#\~/$HOME}"
    local src_dir=""
    local from_repo=0
    if [ -d "$expanded_model" ]; then
        src_dir="$expanded_model"
    elif is_repo_id "$model_arg"; then
        from_repo=1
        if src_dir="$(find_hf_cached_snapshot "$model_arg")"; then
            :
        else
            if [ "$no_pull" -eq 1 ]; then
                die "${model_arg} is not cached locally (re-run without --no-pull or run 'tensorfold pull ${model_arg}')"
            fi
            if [ "$DRY_RUN" -eq 1 ]; then
                echo "[dry-run] would pull ${model_arg} into Hugging Face cache"
                src_dir="<cached:${model_arg}>"
            else
                pull_repo_model "$model_arg"
                src_dir="$(find_hf_cached_snapshot "$model_arg")" || die "pulled ${model_arg} but could not locate snapshot with config.json"
            fi
        fi
    else
        die "'${model_arg}' is neither an existing directory nor a Hugging Face repo id (owner/name)"
    fi

    local fmt_tag="TFQ3"
    [ "$bits_override" = "2" ] && fmt_tag="TFQ4"
    if [ -z "$out_dir" ]; then
        out_dir="$(default_out_dir "$model_arg" "$from_repo" "$fmt_tag")"
    else
        out_dir="${out_dir/#\~/$HOME}"
    fi

    local detected_family="unknown" model_type="unknown" auto_res="bf16" fmt_kind="other" num_layers="0"
    if [ -d "$src_dir" ]; then
        IFS='|' read -r detected_family model_type auto_res fmt_kind num_layers < <(inspect_model_config "$src_dir")
    fi

    if [ "$family" = "auto" ]; then
        if [ -n "$target_gib" ] || [ -n "$fit_mode" ] || [ -n "$bits_override" ] || [ "$quantize_vision" -eq 1 ] || [ "$quantize_drafter" -eq 1 ] || [ "$quantize_embed" -eq 1 ]; then
            family="generic"
        elif [ "$detected_family" != "unknown" ]; then
            family="$detected_family"
        else
            family="generic"
        fi
    fi

    local lib_dir suffix inspect_bin
    lib_dir="$(find_lib_dir)"
    suffix="$(backend_suffix)"
    inspect_bin="$(require_tool "$lib_dir" "tfq3-inspect")"

    echo "=== TFQ3 Convert ==="
    echo "  source:   ${src_dir}"
    echo "  output:   ${out_dir}"
    echo "  family:   ${family} (model_type=${model_type})"
    echo "  backend:  $([ "$(uname -s)" = "Darwin" ] && echo "Apple Silicon Metal" || echo "NVIDIA CUDA")"

    case "$family" in
        generic)
            if [ "${bits_override}" = "2" ]; then
                local tfq4_head_bits="0"
                if [ "$head_bits_set" -eq 1 ]; then
                    case "$head_bits" in
                        0|2) tfq4_head_bits="$head_bits" ;;
                        *) die "invalid --head-bits '${head_bits}' for TFQ4 (--bits 2): expected 0 (keep lm_head in residual, default) or 2" ;;
                    esac
                fi
                local conv_bin
                conv_bin="$(require_tool "$lib_dir" "tfq4-convert${suffix}")"
                local g_flags=(--model "$src_dir" --out "$out_dir" --head-bits "$tfq4_head_bits")
                [ -n "$max_shard_gib" ] && g_flags+=(--max-shard-gib "$max_shard_gib")
                [ "$quantize_vision" -eq 1 ] && g_flags+=(--quantize-vision)
                [ "$quantize_drafter" -eq 1 ] && g_flags+=(--quantize-drafter)
                [ "$quantize_embed" -eq 1 ] && g_flags+=(--quantize-embed)
                echo ""
                if [ "$DRY_RUN" -eq 1 ] && [ -d "$src_dir" ]; then
                    "$conv_bin" "${g_flags[@]}" --dry-run
                else
                    echo "=== [1/2] Quantizing & packaging model (100% data-free TFQ4-E8P 2.001 bpw) ==="
                    run_cmd "$conv_bin" "${g_flags[@]}"
                    echo "=== [2/2] Validating TFQ4 checkpoint ==="
                    run_cmd "$inspect_bin" "$out_dir"
                fi
            else
                case "$head_bits" in 0|4|5) ;; *) die "invalid --head-bits '${head_bits}' for TFQ3 (expected 0, 4, or 5)" ;; esac
                local conv_bin
                conv_bin="$(require_tool "$lib_dir" "tfq3-generic-convert${suffix}")"
                local g_flags=(--model "$src_dir" --out "$out_dir" --profile "$profile" --head-bits "$head_bits")
                [ -n "$bits_override" ] && g_flags+=(--bits "$bits_override")
                [ -n "$target_gib" ] && g_flags+=(--target-gib "$target_gib")
                [ -n "$fit_mode" ] && g_flags+=(--fit "$fit_mode")
                [ "$quantize_vision" -eq 1 ] && g_flags+=(--quantize-vision)
                [ "$quantize_drafter" -eq 1 ] && g_flags+=(--quantize-drafter)
                [ "$quantize_embed" -eq 1 ] && g_flags+=(--quantize-embed)
                echo ""
                if [ "$DRY_RUN" -eq 1 ] && [ -d "$src_dir" ]; then
                    "$conv_bin" "${g_flags[@]}" --dry-run
                else
                    echo "=== [1/2] Quantizing & packaging model (100% data-free generic TFQ3) ==="
                    run_cmd "$conv_bin" "${g_flags[@]}"
                    echo "=== [2/2] Validating TFQ3 checkpoint ==="
                    run_cmd "$inspect_bin" "$out_dir"
                fi
            fi
            ;;
        qwen27)
            case "$profile" in 4b|3.5b|3b) ;; *) die "invalid --profile '${profile}' (expected 4b, 3.5b, or 3b)" ;; esac
            if [ "$residual" = "auto" ]; then residual="$auto_res"; fi
            case "$residual" in bf16|q8) ;; *) die "invalid --residual '${residual}' (expected auto, bf16, or q8)" ;; esac
            local conv_bin pkg_bin
            conv_bin="$(require_tool "$lib_dir" "tfq3-qwen27-convert${suffix}")"
            pkg_bin="$(require_tool "$lib_dir" "tfq3-qwen27-package")"
            echo "  profile:  ${profile} (head=${head_bits}b, residual=${residual})"
            echo ""
            echo "=== [1/3] Quantizing dense weights (100% data-free) ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --profile "$profile" --head-bits "$head_bits"
            echo "=== [2/3] Packaging residual tensors, config.json, and tokenizer ==="
            run_cmd "$pkg_bin" --src "$src_dir" --out "$out_dir" --residual "$residual"
            echo "=== [3/3] Validating TFQ3 checkpoint ==="
            run_cmd "$inspect_bin" "$out_dir"
            ;;
        flashnext)
            case "$ple_bits" in 3|4) ;; *) die "invalid --ple-bits '${ple_bits}' (expected 3 or 4)" ;; esac
            local conv_bin pkg_py
            conv_bin="$(require_tool "$lib_dir" "tfq3-flashnext-convert${suffix}")"
            pkg_py="$(find_flashnext_packager "$lib_dir")"
            local extra_flags=()
            [ -n "$trace_file" ] && extra_flags+=(--trace "$trace_file")
            [ "$skip_existing" -eq 1 ] && extra_flags+=(--skip-existing)
            echo "  ple_bits: ${ple_bits}"
            [ -n "$trace_file" ] && echo "  trace:    ${trace_file}"
            echo ""
            echo "=== [1/5] Quantizing boundary MoE layers (L0-L5: 5b/4b/3b) ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode moe --layers 0 5 --n5 64 --n4 192 ${extra_flags[@]+"${extra_flags[@]}"}
            echo "=== [2/5] Quantizing deep MoE layers (L6-L46: 4b/3b) ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode moe --layers 6 46 --n5 0 --n4 192 ${extra_flags[@]+"${extra_flags[@]}"}
            echo "=== [3/5] Quantizing final MoE layer + MTP drafter (L47 + MTP: 5b/4b/3b) ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode moe --layers 47 47 --n5 64 --n4 192 --mtp ${extra_flags[@]+"${extra_flags[@]}"}
            echo "=== [4/5] Requantizing PLE embeddings (${ple_bits}-bit/32) & packaging standalone checkpoint ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode requant-ple --ple-bits "$ple_bits"
            run_cmd python3 "$pkg_py" --src "$src_dir" --out "$out_dir" --extract-nonmoe --write-index --ple-bits "$ple_bits" --move-ple
            echo "=== [5/5] Validating TFQ3 checkpoint ==="
            run_cmd "$inspect_bin" "$out_dir"
            ;;
        glm)
            case "$glm_mode" in heat43|heat443|uniform4|uniform3) ;; *) die "invalid --glm-mode '${glm_mode}' (expected heat43, heat443, uniform4, or uniform3)" ;; esac
            local conv_bin
            conv_bin="$(require_tool "$lib_dir" "tfq3-glm-convert${suffix}")"
            local extra_flags=()
            [ -n "$trace_file" ] && extra_flags+=(--trace "$trace_file")
            [ "$skip_existing" -eq 1 ] && extra_flags+=(--skip-existing)
            local boundary_mode="heat543"
            [ "$glm_mode" = "uniform4" ] && boundary_mode="uniform4"
            local glm_l_end=44
            if [ "$model_type" = "glm_moe_dsa" ] && [ "${num_layers:-0}" -gt 45 ]; then
                glm_l_end=$((num_layers - 1))
            fi
            echo "  glm_mode: ${glm_mode} (boundary=${boundary_mode}, layers=3..${glm_l_end}, keep_nonmoe_bf16=${keep_nonmoe_bf16})"
            echo ""
            if [ "$fmt_kind" = "fp8" ] || [ -n "$nonmoe_model" ] || [ "$keep_nonmoe_bf16" -eq 1 ]; then
                echo "=== [1/3] Quantizing boundary MoE layers (L3-L6: ${boundary_mode}) ==="
                run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode "$boundary_mode" --layers 3 6 ${extra_flags[@]+"${extra_flags[@]}"}
                echo "=== [2/3] Quantizing deep MoE layers (L7-L${glm_l_end}: ${glm_mode}) ==="
                run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode "$glm_mode" --layers 7 "$glm_l_end" ${extra_flags[@]+"${extra_flags[@]}"}
                if [ "$keep_nonmoe_bf16" -eq 1 ]; then
                    echo "=== [3/3] Keeping non-MoE (attention/shared/router/embed/head) untouched (--keep-nonmoe-bf16) ==="
                elif [ -n "$nonmoe_model" ]; then
                    echo "=== [3/3] Quantizing non-MoE + shared experts + lm_head (fast4b) ==="
                    run_cmd "$conv_bin" --model "${nonmoe_model/#\~/$HOME}" --out "$out_dir" --mode nonmoe --fast4b
                elif [ "$auto_res" = "q8" ]; then
                    echo "=== [3/3] Quantizing non-MoE + shared experts + lm_head from hybrid MLX-Q8 source (fast4b) ==="
                    run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode nonmoe --fast4b
                else
                    echo "=== [3/3] MoE layers complete (pass --nonmoe-model <8bit-dir> to quantize nonmoe.tffpw, or --keep-nonmoe-bf16 to keep non-MoE unquantized) ==="
                fi
            elif [ "$auto_res" = "q8" ]; then
                echo "=== [1/2] Quantizing GLM non-MoE + shared experts + lm_head (fast4b) ==="
                run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode nonmoe --fast4b
                echo "=== [2/2] Validating TFQ3 output ==="
            else
                echo "=== [1/3] Quantizing boundary MoE layers (L3-L6: ${boundary_mode}) ==="
                run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode "$boundary_mode" --layers 3 6 ${extra_flags[@]+"${extra_flags[@]}"}
                echo "=== [2/3] Quantizing deep MoE layers (L7-L${glm_l_end}: ${glm_mode}) ==="
                run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode "$glm_mode" --layers 7 "$glm_l_end" ${extra_flags[@]+"${extra_flags[@]}"}
                if [ "$keep_nonmoe_bf16" -eq 1 ]; then
                    echo "=== [3/3] Keeping non-MoE (attention/shared/router/embed/head) in full precision (--keep-nonmoe-bf16) ==="
                else
                    echo "=== [3/3] Quantizing non-MoE + shared experts + lm_head (fast4b) ==="
                    run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode nonmoe --fast4b
                fi
            fi
            run_cmd "$inspect_bin" "$out_dir"
            ;;
        inkling2)
            if [ -z "$inkling2_mode" ]; then
                case "$profile" in
                    4b)   inkling2_mode="uniform4" ;;
                    3.5b) inkling2_mode="heat43" ;;
                    3b)   inkling2_mode="uniform3" ;;
                    *)    die "invalid --profile '${profile}' for Inkling-2 (expected 4b, 3.5b, or 3b, or pass --inkling2-mode)" ;;
                esac
            fi
            case "$inkling2_mode" in uniform4|heat543|heat443|heat43|uniform3) ;; *) die "invalid --inkling2-mode '${inkling2_mode}'" ;; esac
            local conv_bin
            conv_bin="$(require_tool "$lib_dir" "tfq3-inkling2-convert${suffix}")"
            local extra_flags=()
            [ -n "$trace_file" ] && extra_flags+=(--trace "$trace_file")
            [ "$skip_existing" -eq 1 ] && extra_flags+=(--skip-existing)
            echo "  inkling2_mode: ${inkling2_mode}"
            echo ""
            echo "=== [1/2] Quantizing Inkling-2 MoE layers (NVFP4 + MXFP8 -> TFPW v3) & exporting BF16 residuals ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --mode "$inkling2_mode" --copy-residuals ${extra_flags[@]+"${extra_flags[@]}"}
            echo "=== [2/2] Validating TFQ3 output ==="
            run_cmd "$inspect_bin" "$out_dir"
            ;;
        ernie)
            [ "$(uname -s)" != "Darwin" ] || die "the ERNIE converter is CUDA-only (there is no Metal build)"
            [ "$fmt_kind" != "fp8" ] || die "ERNIE needs the BF16 checkpoint (e.g. baidu/ERNIE-5.5-Flash-Preview-BF16); ${src_dir} is quantized"
            [ -z "$bits_override" ] || die "for ERNIE, set the expert width with --profile 3b|4b|5b instead of --bits"
            local ernie_bits
            case "$profile" in 3b|4b|5b) ernie_bits="${profile%b}" ;; *) die "invalid --profile '${profile}' for ERNIE (expected 3b, 4b, or 5b)" ;; esac
            local conv_bin
            conv_bin="$(require_tool "$lib_dir" "tfq3-ernie-convert-cuda")"
            local extra_flags=()
            [ "$skip_existing" -eq 1 ] && extra_flags+=(--skip-existing)
            echo "  profile:  ${profile} (uniform ${ernie_bits}-bit routed experts)"
            echo ""
            echo "=== [1/2] Quantizing routed MoE experts (L1-L42: uniform ${ernie_bits}-bit) ==="
            run_cmd "$conv_bin" --model "$src_dir" --out "$out_dir" --layers 1 42 --bits "$ernie_bits" ${extra_flags[@]+"${extra_flags[@]}"}
            echo "=== [2/2] Validating TFQ3 output ==="
            run_cmd "$inspect_bin" "$out_dir"
            ;;
        *)
            die "unknown family '${family}' (expected auto, generic, qwen27, flashnext, glm, inkling2, or ernie)"
            ;;
    esac

    if [ "$DRY_RUN" -eq 0 ]; then
        echo ""
        if [ "$family" = "ernie" ]; then
            echo "${fmt_tag} routed experts ready: ${out_dir}"
            echo "Every other tensor stays in the source checkpoint."
        else
            echo "${fmt_tag} checkpoint ready: ${out_dir}"
            echo "Serve on Mac (Metal) or NVIDIA GPU (CUDA) with TensorFold:"
            echo "  tensorfold serve ${out_dir}"
        fi
    fi
}

if [ $# -eq 0 ]; then
    usage
    exit 0
fi

case "$1" in
    -h|--help|help)
        usage
        exit 0
        ;;
    -V|--version|version)
        echo "tfq3 ${TFQ3_VERSION}"
        exit 0
        ;;
    doctor)
        run_doctor
        ;;
    inspect)
        shift
        lib_dir="$(find_lib_dir)"
        inspect_bin="$(require_tool "$lib_dir" "tfq3-inspect")"
        exec "$inspect_bin" "$@"
        ;;
    convert)
        shift
        run_convert "$@"
        ;;
    *)
        run_convert "$@"
        ;;
esac
